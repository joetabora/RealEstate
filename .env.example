# PostgreSQL (docker compose maps host 5433 → container 5432)
DATABASE_URL="postgresql://examcoach:examcoach@localhost:5433/examcoach?schema=public"

# Local course files. Never commit this directory.
SOURCE_MATERIAL_PATH="./source-material"

# Local page PNG renders for OCR-needed sections (gitignored under data/).
# LOCAL_PAGE_RENDER_PATH="./data/page-renders"

# Class-miss photo uploads (gitignored under data/).
# LOCAL_CLASS_MISS_PATH="./data/class-miss-photos"

# Local Whisper transcript sidecars (gitignored under data/).
# LOCAL_TRANSCRIPT_PATH="./data/video-transcripts"
# WHISPER_MODEL=tiny

# Optional Phase 7 live tutor + Phase 13 live draft generation
# (leave empty to use Off/Mock only; core study never requires a key)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Soft daily spend estimate shared by live tutor + live generation (USD)
# TUTOR_DAILY_SPEND_CAP_USD=1
# TUTOR_USD_PER_1K_TOKENS=0.002
