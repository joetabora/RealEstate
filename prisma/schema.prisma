generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A versioned offering of the course (e.g. WRA Sales 2024).
/// Future editions (2027) can coexist without destroying older material.
model CourseEdition {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  jurisdiction String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  examCategories   ExamCategory[]
  learningSessions LearningSession[]
  sourceDocuments  SourceDocument[]
  concepts         Concept[]
  confusionPairs   ConfusionPair[]
  learningAssets   LearningAsset[]
  questions        Question[]
}

/// Official Wisconsin salesperson exam weighting structure (Pearson outline).
/// This is not course content. It classifies and weights exam readiness.
model ExamCategory {
  id        String        @id @default(cuid())
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  /// Roman code from the public outline, e.g. "I" … "X".
  code      String
  name      String
  /// Number of scored items on the salesperson exam.
  weight    Int
  sortOrder Int

  /// Reserved for sub-weights (e.g. III.A Valuation) without requiring them in Phase 1.
  parentId String?
  parent   ExamCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ExamCategory[] @relation("CategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  concepts ConceptExamCategory[]
  questions QuestionExamCategory[]

  @@unique([editionId, code])
  @@index([editionId, sortOrder])
}

/// Personal product: a single local learner. Keep userId-shaped keying for later.
model Learner {
  id        String   @id @default(cuid())
  /// Stable application key. The Phase 1 singleton is "local".
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions LearningSession[]
  attempts QuestionAttempt[]
  knowledgeStates KnowledgeState[]
  performanceStates PerformanceState[]
  mistakes Mistake[]
}

/// A Teach Me (or future) study session. Planner fills items in later phases.
model LearningSession {
  id        String         @id @default(cuid())
  learnerId String
  learner   Learner        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  editionId String?
  edition   CourseEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  objective      String?
  targetMinutes  Int?
  plannerVersion String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  /// Snapshots of knowledge/performance/review state. Unused until Phase 4+.
  stateBefore     Json?
  stateAfter      Json?
  recommendedNext String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SessionItem[]
}

/// One step inside a session (review, repair, learn, teach-back, practice, recall).
model SessionItem {
  id        String          @id @default(cuid())
  sessionId String
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sortOrder   Int
  /// Extensible kind string: review | repair | learn | teachback | practice | recall
  kind        String
  reasonCodes String[]      @default([])

  conceptId String?
  concept   Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  assetId   String?
  asset     LearningAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  questionId String?
  question   Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attempts QuestionAttempt[]

  @@index([sessionId, sortOrder])
  @@index([conceptId])
  @@index([assetId])
  @@index([questionId])
}

/// A layered source work (course book, chapter notes, forms, glossary, …).
/// Extracted text lives here in the local database, never in git.
model SourceDocument {
  id        String        @id @default(cuid())
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  slug  String
  title String
  /// course_book | chapter_notes | dated_update | exam_blueprint | glossary | forms | math_appendix | story_problem | practice_exam | pedagogy
  layer String
  /// educational | regulatory_exam | pedagogical
  authority    String
  jurisdiction String @default("WI")

  /// Path relative to SOURCE_MATERIAL_PATH. Empty when there is no local file.
  relativePath   String  @default("")
  fileName       String  @default("")
  checksumSha256 String?

  publishedAt DateTime?
  effectiveAt DateTime?

  pageCount    Int @default(0)
  firstPdfPage Int @default(1)
  lastPdfPage  Int @default(1)

  /// Practice-exam stems stay in the DB but are not reconstructed in Library.
  hideBodyInUi Boolean @default(false)

  ingestedAt    DateTime @default(now())
  ingestVersion String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections           SourceSection[]
  assets             SourceAsset[]
  superseding        SourceSupersession[] @relation("SupersedingDocument")
  superseded         SourceSupersession[] @relation("SupersededDocument")

  @@unique([editionId, slug])
  @@index([editionId, layer])
}

/// A cited slice of a source document (heading, chapter, or page).
model SourceSection {
  id         String         @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  sortOrder   Int
  heading     String
  headingPath String[] @default([])
  /// chapter | heading | page | part
  kind        String   @default("heading")

  chapterNumber Int?
  chapterTitle  String?

  pdfPageStart     Int
  pdfPageEnd       Int
  printedPageStart Int?
  printedPageEnd   Int?

  body          String @db.Text
  charCount     Int
  tokenEstimate Int

  /// Image-heavy pages with no usable extractable text. OCR is Phase 10.
  needsOcr Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anchors        VisualAnchor[]
  citations      ConceptCitation[]
  assetCitations AssetCitation[]
  questionCitations QuestionCitation[]

  @@index([documentId, sortOrder])
  @@index([documentId, chapterNumber])
}

/// An update may qualify or supersede a book section; both records remain.
model SourceSupersession {
  id String @id @default(cuid())

  supersedingDocumentId String
  supersedingDocument   SourceDocument @relation("SupersedingDocument", fields: [supersedingDocumentId], references: [id], onDelete: Cascade)
  supersedingSectionId  String?

  supersededDocumentId String
  supersededDocument   SourceDocument @relation("SupersededDocument", fields: [supersededDocumentId], references: [id], onDelete: Cascade)
  supersededSectionId  String?

  note String?

  createdAt DateTime @default(now())

  @@index([supersededDocumentId])
  @@index([supersedingDocumentId])
}

/// Local binary/render placeholder. filePath is never committed.
model SourceAsset {
  id         String         @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// pdf | page_render | form_pdf_page | table | diagram
  kind        String
  pdfPage     Int?
  printedPage Int?
  filePath    String?
  mimeType    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anchors VisualAnchor[]

  @@index([documentId, pdfPage])
}

/// Page-number placeholder until OCR / page images exist.
model VisualAnchor {
  id String @id @default(cuid())

  assetId   String?
  asset     SourceAsset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  sectionId String?
  section   SourceSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  pdfPage     Int
  printedPage Int?

  formNumber String?
  lineRange  String?
  bboxX      Float?
  bboxY      Float?
  bboxWidth  Float?
  bboxHeight Float?

  label String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pdfPage])
  @@index([sectionId])
}

/// A teachable idea in one course edition. Labels and citations only — not a reconstructed chapter.
model Concept {
  id        String        @id @default(cuid())
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  slug          String
  name          String
  chapterNumber Int
  /// roles | models | duties | disclosure | office | broker-definition
  group       String
  /// wi | general | both
  jurisdictionScope String
  sortOrder         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citations      ConceptCitation[]
  examCategories ConceptExamCategory[]
  outgoing       ConceptRelationship[] @relation("RelationshipFrom")
  incoming       ConceptRelationship[] @relation("RelationshipTo")
  confusionA     ConfusionPair[]       @relation("ConfusionConceptA")
  confusionB     ConfusionPair[]       @relation("ConfusionConceptB")
  assets         LearningAsset[]
  sessionItems   SessionItem[]
  questions      Question[]
  knowledgeStates KnowledgeState[]
  performanceStates PerformanceState[]
  mistakes       Mistake[]

  @@unique([editionId, slug])
  @@index([editionId, chapterNumber, sortOrder])
}

model ConceptCitation {
  id         String        @id @default(cuid())
  conceptId  String
  concept    Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    SourceSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  documentSlug String
  heading      String
  pdfPage      Int
  printedPage  Int?
  /// course_book | chapter_notes
  layer String

  createdAt DateTime @default(now())

  @@index([conceptId])
  @@index([sectionId])
}

model ConceptExamCategory {
  conceptId      String
  concept        Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  examCategoryId String
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  @@id([conceptId, examCategoryId])
}

model ConceptRelationship {
  id           String  @id @default(cuid())
  fromConceptId String
  fromConcept   Concept @relation("RelationshipFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConceptId   String
  toConcept     Concept @relation("RelationshipTo", fields: [toConceptId], references: [id], onDelete: Cascade)
  /// prerequisite | part_of | related
  kind String

  createdAt DateTime @default(now())

  @@unique([fromConceptId, toConceptId, kind])
  @@index([toConceptId])
}

model ConfusionPair {
  id        String        @id @default(cuid())
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  conceptAId String
  conceptA   Concept @relation("ConfusionConceptA", fields: [conceptAId], references: [id], onDelete: Cascade)
  conceptBId String
  conceptB   Concept @relation("ConfusionConceptB", fields: [conceptBId], references: [id], onDelete: Cascade)

  /// Unordered pair key: sorted slugs joined by "|".
  canonicalKey String
  reason       String
  source       String  @default("seed")
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence ConfusionEvidence[]
  assets   LearningAsset[]
  questions Question[]
  mistakes Mistake[]

  @@unique([editionId, canonicalKey])
  @@index([editionId, active])
}

model ConfusionEvidence {
  id     String        @id @default(cuid())
  pairId String
  pair   ConfusionPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  /// seed | distractor | repeated_miss | teachback
  kind String
  note String?

  createdAt DateTime @default(now())

  @@index([pairId])
}

/// A hand-authored teaching unit. Original language plus citations — not a reconstructed chapter.
model LearningAsset {
  id        String        @id @default(cuid())
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  slug String
  /// explanation | simple_language | scenario | comparison | teachback_prompt | recall_prompt
  kind String
  /// course_sourced | general_explanation | needs_verification
  informationClass String
  /// generated | extracted | active | rejected — Phase 4 seed is active
  lifecycle String @default("active")

  conceptId String?
  concept   Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  pairId    String?
  pair      ConfusionPair? @relation(fields: [pairId], references: [id], onDelete: SetNull)

  title     String
  body      String @db.Text
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citations    AssetCitation[]
  sessionItems SessionItem[]

  @@unique([editionId, slug])
  @@index([editionId, lifecycle, sortOrder])
  @@index([conceptId])
  @@index([pairId])
}

model AssetCitation {
  id      String        @id @default(cuid())
  assetId String
  asset   LearningAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sectionId String?
  section   SourceSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  documentSlug String
  heading      String
  pdfPage      Int
  printedPage  Int?
  layer        String

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([sectionId])
}

/// Hand-authored scored item. Stem + options + citations — not a reconstructed exam.
model Question {
  id        String        @id @default(cuid())
  editionId String
  edition   CourseEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  slug String
  /// mcq | true_false | short — Phase 5 seeds mcq
  kind String @default("mcq")
  /// course_sourced | general_explanation | needs_verification
  informationClass String
  /// generated | extracted | active | rejected — Phase 5 seed is active
  lifecycle String @default("active")

  chapterNumber Int
  stem          String @db.Text
  /// Shown after a miss: why the choice was wrong at a high level.
  remediationWhyMissed String @db.Text
  /// Shown after a miss: the core distinction to remember.
  remediationDistinction String @db.Text

  conceptId String?
  concept   Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  pairId    String?
  pair      ConfusionPair? @relation(fields: [pairId], references: [id], onDelete: SetNull)

  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options        QuestionOption[]
  citations      QuestionCitation[]
  examCategories QuestionExamCategory[]
  sessionItems   SessionItem[]
  attempts       QuestionAttempt[]
  mistakes       Mistake[]

  @@unique([editionId, slug])
  @@index([editionId, lifecycle, chapterNumber, sortOrder])
  @@index([conceptId])
  @@index([pairId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// A | B | C | D
  key       String
  body      String @db.Text
  isCorrect Boolean
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts QuestionAttempt[]

  @@unique([questionId, key])
  @@index([questionId, sortOrder])
}

model QuestionCitation {
  id         String         @id @default(cuid())
  questionId String
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    SourceSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  documentSlug String
  heading      String
  pdfPage      Int
  printedPage  Int?
  layer        String

  createdAt DateTime @default(now())

  @@index([questionId])
  @@index([sectionId])
}

model QuestionExamCategory {
  questionId     String
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examCategoryId String
  examCategory   ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Cascade)

  @@id([questionId, examCategoryId])
}

/// One learner answer. Knowledge vs performance are updated from these rows.
model QuestionAttempt {
  id         String   @id @default(cuid())
  learnerId  String
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  sessionItemId String?
  sessionItem   SessionItem? @relation(fields: [sessionItemId], references: [id], onDelete: SetNull)

  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  correct    Boolean
  /// Optional 1–5. Overconfident misses get repair priority later.
  confidence Int?
  latencyMs  Int?
  /// confusion | knowledge_gap | overconfidence | other
  errorCategory String?

  createdAt DateTime @default(now())

  mistake Mistake?

  @@index([learnerId, createdAt])
  @@index([questionId])
  @@index([sessionItemId])
}

/// Understanding signal for a concept (not exam survival).
model KnowledgeState {
  id         String  @id @default(cuid())
  learnerId  String
  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conceptId  String
  concept    Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  /// not_started | learning | familiar
  status    String   @default("not_started")
  timesSeen Int      @default(0)
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([learnerId, conceptId])
  @@index([learnerId, status])
}

/// Exam-condition signal for a concept (attempts, not a single mastery %).
model PerformanceState {
  id        String  @id @default(cuid())
  learnerId String
  learner   Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conceptId String
  concept   Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  attempts      Int       @default(0)
  correctCount  Int       @default(0)
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([learnerId, conceptId])
  @@index([learnerId])
}

/// A miss retained for repair. Photo miss intake still comes later.
model Mistake {
  id         String   @id @default(cuid())
  learnerId  String
  learner    Learner  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptId  String   @unique
  attempt    QuestionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  conceptId String?
  concept   Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  pairId    String?
  pair      ConfusionPair? @relation(fields: [pairId], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([learnerId, resolvedAt, createdAt])
  @@index([questionId])
}
